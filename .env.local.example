# ============================================================
#  .env.local.example
#  Copia este archivo como `.env.local` y rellena los valores.
#  En Azure Container Apps crea Secrets con EXACTAMENTE estos
#  mismos nombres (sin prefijo VITE_).
# ============================================================

# ───── Base de datos (Neon) ─────
NEON_DATABASE_URL=""

# ───── OpenAI ─────
OPENAI_API_KEY=""

# ───── Azure Container Apps (runner de funciones) ─────
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""
AZURE_LOCATION=""
AZURE_ACA_ENVIRONMENT=""
FN_RUNNER_IMAGE=""
